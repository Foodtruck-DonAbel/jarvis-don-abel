<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora Don Abel</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
  :root {
    --bg:#0a0d14;--surface:#111520;--surface2:#181d2e;--surface3:#1f2640;
    --border:#2a3350;--border2:#3a4870;--navy:#1e3a6e;--navy-light:#2d5299;
    --accent:#4472c8;--accent2:#6b9fe8;--green:#2ecc71;--green-dim:rgba(46,204,113,0.15);
    --red:#e74c3c;--red-dim:rgba(231,76,60,0.15);--yellow:#f39c12;--yellow-dim:rgba(243,156,18,0.15);
    --text:#e8ecf5;--text2:#a8b4cc;--muted:#5a6a8a;
    --mayorista:#4472c8;--surpartner:#8b5cf6;--evercrisp:#10b981;
    --radius-sm:8px;--radius:14px;--radius-lg:20px;
    --shadow:0 4px 20px rgba(0,0,0,0.3);
  }
  body.light-mode {
    --bg:#f0f4ff;--surface:#ffffff;--surface2:#e8edf8;--surface3:#dce3f5;
    --border:#c8d0e8;--border2:#a8b4d0;--navy:#1e3a6e;--navy-light:#2d5299;
    --accent:#4472c8;--accent2:#2d5299;--green:#1a8a4a;--green-dim:rgba(26,138,74,0.12);
    --red:#c0392b;--red-dim:rgba(192,57,43,0.1);--yellow:#b7770d;--yellow-dim:rgba(183,119,13,0.1);
    --text:#1a2240;--text2:#3a4870;--muted:#7a8ab0;
    --shadow:0 4px 20px rgba(68,114,200,0.12);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Syne',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:20px 16px 40px;background-image:radial-gradient(ellipse 80% 40% at 50% -10%,rgba(68,114,200,0.12) 0%,transparent 70%),radial-gradient(ellipse 40% 30% at 90% 80%,rgba(30,58,110,0.08) 0%,transparent 60%);}
  .header{text-align:center;padding:0;margin-bottom:6px;position:relative;}
  .header::after{content:none;display:none;}
  .header-logo{width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid var(--border2);margin-bottom:10px;box-shadow:0 0 24px rgba(68,114,200,0.2);}
  .header h1{font-size:26px;font-weight:800;letter-spacing:-0.5px;color:#fff;}
  .header h1 span{color:var(--accent2);}
  .header p{font-size:13px;color:var(--muted);margin-top:4px;letter-spacing:1px;text-transform:uppercase;}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;margin-bottom:16px;position:relative;overflow:hidden;}
  .card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--border2),transparent);}
  .card-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--muted);margin-bottom:14px;}
  .user-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .user-btn{padding:12px 6px;border-radius:var(--radius);border:2px solid var(--border);background:var(--surface2);color:var(--muted);font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;text-align:center;letter-spacing:1px;}
  .user-btn:hover{border-color:var(--border2);color:var(--text2);}
  .user-btn.active{border-color:var(--accent);color:#fff;background:linear-gradient(135deg,var(--navy),var(--navy-light));box-shadow:0 4px 20px rgba(68,114,200,0.25);}
  .badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}
  .form-group{margin-bottom:14px;}
  .form-label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:var(--text2);margin-bottom:7px;}
  .form-input{width:100%;padding:13px 16px;background:var(--surface2);border:2px solid var(--border);border-radius:var(--radius);color:var(--text);font-family:'JetBrains Mono',monospace;font-size:15px;outline:none;transition:border-color 0.2s,box-shadow 0.2s;}
  .form-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(68,114,200,0.15);}
  .form-input::placeholder{color:var(--muted);font-size:13px;}
  /* Neutralizar autofill del browser */
  .form-input:-webkit-autofill,
  .form-input:-webkit-autofill:hover,
  .form-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0px 1000px var(--surface2) inset !important;
    -webkit-text-fill-color: var(--text) !important;
    transition: background-color 5000s ease-in-out 0s;
  }
  .toggle-row{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding:12px 14px;background:var(--surface2);border-radius:var(--radius);border:1px solid var(--border);}
  .toggle-label{font-size:14px;color:var(--text2);flex:1;font-weight:500;}
  .toggle{position:relative;width:46px;height:26px;flex-shrink:0;}
  .toggle input{opacity:0;width:0;height:0;}
  .toggle-slider{position:absolute;inset:0;background:var(--border2);border-radius:26px;cursor:pointer;transition:0.2s;}
  .toggle-slider:before{content:'';position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:0.2s;}
  .toggle input:checked+.toggle-slider{background:var(--surpartner);}
  .toggle input:checked+.toggle-slider:before{transform:translateX(20px);}
  .row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .link-mayorista{display:flex;align-items:center;gap:8px;padding:11px 16px;background:var(--surface2);border:2px solid var(--border);border-radius:var(--radius);color:var(--accent2);text-decoration:none;font-size:13px;font-weight:600;margin-bottom:14px;transition:border-color 0.2s;letter-spacing:0.3px;}
  .link-mayorista:hover{border-color:var(--accent);}
  .btn-calc{width:100%;padding:15px;border-radius:var(--radius);border:none;background:linear-gradient(135deg,var(--navy-light),var(--accent));color:#fff;font-family:'Syne',sans-serif;font-size:16px;font-weight:700;cursor:pointer;transition:opacity 0.15s,transform 0.1s;margin-bottom:16px;letter-spacing:0.5px;box-shadow:0 4px 20px rgba(68,114,200,0.3);}
  .btn-calc:active{transform:scale(0.98);}
  .btn-calc:disabled{opacity:0.4;cursor:not-allowed;}
  .costo-real-box{background:var(--surface2);border:2px solid var(--surpartner);border-radius:var(--radius);padding:14px 16px;margin-bottom:14px;display:none;}
  .costo-real-box .label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;font-weight:700;}
  .costo-real-box .valor{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;color:var(--surpartner);margin-top:4px;}
  .desglose{margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:5px;}
  .desglose-row{display:flex;justify-content:space-between;font-size:13px;color:var(--text2);font-family:'JetBrains Mono',monospace;}
  .desglose-row.total{color:var(--surpartner);font-weight:700;font-size:14px;padding-top:6px;border-top:1px solid var(--border);margin-top:2px;}
  .iaba-select-wrap{position:relative;margin-bottom:14px;}
  .iaba-select-wrap::after{content:'\25be';position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;font-size:14px;}
  .iaba-select{width:100%;padding:13px 40px 13px 16px;background:var(--surface2);border:2px solid var(--border);border-radius:var(--radius);color:var(--text);font-family:'Syne',sans-serif;font-size:14px;font-weight:600;cursor:pointer;outline:none;appearance:none;-webkit-appearance:none;transition:border-color 0.2s;}
  .iaba-select:focus{border-color:var(--surpartner);}
  .iaba-select option{background:#181d2e;color:var(--text);}
  .alerta{border-radius:var(--radius);padding:14px 16px;margin-bottom:14px;display:none;font-size:14px;line-height:1.6;font-weight:500;}
  .alerta-roja{background:var(--red-dim);border:2px solid var(--red);color:#ff8a80;}
  .alerta-verde{background:var(--green-dim);border:2px solid var(--green);color:#69f0ae;}
  .margenes-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;}
  .margen-item{background:var(--surface2);border:2px solid var(--border);border-radius:var(--radius);padding:12px 14px;display:flex;flex-direction:column;gap:4px;transition:border-color 0.2s;}
  .margen-item:hover{border-color:var(--border2);}
  .margen-item.highlight{border-color:var(--accent);background:linear-gradient(135deg,rgba(30,58,110,0.4),rgba(68,114,200,0.1));box-shadow:0 4px 16px rgba(68,114,200,0.15);}
  .margen-item.pedidosya{border-color:#FF2C55;background:rgba(255,44,85,0.12);grid-column:span 2;flex-direction:row;align-items:center;justify-content:space-between;}
  .margen-label{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px;}
  .margen-valor{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--text);}
  .margen-item.highlight .margen-valor{color:var(--accent2);font-size:24px;}
  .margen-item.pedidosya .margen-valor{font-size:18px;color:#FF2C55;}
  .margenes-grid-pack{display:grid;grid-template-columns:100px 1fr 1fr;gap:8px;margin-bottom:16px;}
  .pack-header{font-size:10px;font-weight:700;text-transform:uppercase;color:var(--muted);letter-spacing:1px;padding:8px 12px;background:var(--surface3);border-radius:var(--radius-sm);text-align:center;border:1px solid var(--border);}
  .btn-save{width:100%;padding:15px;border-radius:var(--radius);border:none;background:linear-gradient(135deg,#1a7a4a,var(--green));color:#fff;font-family:'Syne',sans-serif;font-size:16px;font-weight:700;cursor:pointer;transition:opacity 0.15s,transform 0.1s;display:none;letter-spacing:0.5px;box-shadow:0 4px 20px rgba(46,204,113,0.25);}
  .btn-save:active{transform:scale(0.98);}
  .hist-item{background:var(--surface2);border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:8px;border-left:3px solid var(--border2);transition:border-color 0.2s;}
  .hist-item.subio{border-left-color:var(--red);}
  .hist-item.igual{border-left-color:var(--green);}
  .hist-fecha{font-size:11px;color:var(--muted);margin-bottom:2px;}
  .hist-costo{font-family:'JetBrains Mono',monospace;font-size:16px;font-weight:600;color:var(--text);}
  .toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:linear-gradient(135deg,#1a7a4a,var(--green));color:#fff;padding:13px 28px;border-radius:50px;font-size:14px;font-weight:700;transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);z-index:999;white-space:nowrap;box-shadow:0 8px 30px rgba(46,204,113,0.3);font-family:'Syne',sans-serif;letter-spacing:0.5px;}
  .toast.show{transform:translateX(-50%) translateY(0);}
  .sep{height:1px;background:var(--border);margin:14px 0;}
  .spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite;vertical-align:middle;margin-right:6px;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .input-money-wrap{position:relative;}
  .input-money-wrap::before{content:'$';position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--accent2);font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600;pointer-events:none;z-index:1;}
  .input-money-wrap .form-input{padding-left:28px;}
  .prov-tabs{display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:0;}
  .prov-tab{padding:10px 20px;background:transparent;border:none;color:var(--muted);font-family:'Syne',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.2s;letter-spacing:0.3px;border-bottom:2px solid transparent;margin-bottom:-2px;}
  .prov-tab:hover{color:var(--text2);}
  .prov-tab.active{color:#fff;border-bottom-color:var(--accent);}
  .prov-tab-content{display:none;padding-top:14px;}
  .prov-tab-content.active{display:block;}
  .prov-sub{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;}
  .prov-btn{padding:12px 8px;border-radius:var(--radius-sm);border:2px solid var(--border);background:var(--surface2);color:var(--text2);font-family:'Syne',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;text-align:center;letter-spacing:0.3px;line-height:1.3;width:100%;}
  .prov-btn:hover{border-color:var(--border2);color:var(--text);}
  .prov-btn.active{color:#fff;box-shadow:0 4px 16px rgba(0,0,0,0.3);}
  .hidden{display:none !important;}

  /* ── MENÚ ADM ── */
  .adm-menu{display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:2000;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);justify-content:center;align-items:center;}
  .adm-menu.show{display:flex;}
  .adm-menu-box{background:var(--surface);border:1px solid var(--border2);border-radius:20px;padding:24px;width:min(340px,90vw);box-shadow:0 20px 60px rgba(0,0,0,0.5);}
  .adm-menu-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);margin-bottom:16px;text-align:center;}
  .adm-menu-btn{width:100%;padding:16px;border-radius:14px;border:2px solid var(--border2);background:var(--surface2);color:var(--text);font-family:'Syne',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:all 0.15s;text-align:left;display:flex;align-items:center;gap:12px;margin-bottom:10px;}
  .adm-menu-btn:hover{border-color:var(--accent);background:rgba(68,114,200,0.1);}
  .adm-menu-btn .adm-menu-icon{font-size:24px;width:36px;text-align:center;}
  .adm-menu-btn .adm-menu-desc{font-size:11px;color:var(--muted);font-weight:500;margin-top:2px;}
  .adm-menu-close{width:100%;padding:10px;border-radius:10px;border:1px solid var(--border);background:transparent;color:var(--muted);font-family:'Syne',sans-serif;font-size:13px;font-weight:600;cursor:pointer;margin-top:4px;}
  .adm-menu-close:hover{color:var(--text);}

  /* ── CHIP DE SESIÓN ── */
  .session-chip{display:flex;align-items:center;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:10px;min-height:22px;}
  .chip{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:0.3px;border:1px solid var(--border2);background:var(--surface2);color:var(--text2);transition:all 0.2s;}
  .chip.active{background:rgba(68,114,200,0.15);border-color:var(--accent);color:var(--text);}
  .chip-dot{width:6px;height:6px;border-radius:50%;background:var(--muted);flex-shrink:0;}
  .chip.active .chip-dot{background:var(--green);}
  .chip-sep{color:var(--border2);font-size:10px;user-select:none;}

  /* ── CONTADOR GUARDADOS ── */
  .guardados-badge{display:none;position:fixed;top:52px;right:16px;z-index:990;background:var(--surface2);border:1px solid var(--green);border-radius:20px;padding:4px 12px;font-size:12px;font-weight:700;color:var(--green);font-family:'JetBrains Mono',monospace;box-shadow:var(--shadow);}

  /* ── TOAST ERROR separado ── */
  .toast-error{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:linear-gradient(135deg,#7f1d1d,var(--red));color:#fff;padding:13px 28px;border-radius:50px;font-size:14px;font-weight:700;transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);z-index:998;white-space:nowrap;box-shadow:0 8px 30px rgba(231,76,60,0.3);font-family:'Syne',sans-serif;letter-spacing:0.5px;}
  .toast-error.show{transform:translateX(-50%) translateY(0);}

  /* ── BORDE COLOR PROVEEDOR ── */
  .card.prov-activa{border-top:3px solid var(--prov-color,var(--accent));}
  .card.prov-activa::before{background:linear-gradient(90deg,transparent,var(--prov-color,var(--accent)),transparent);}

  /* ── BOTÓN NUEVO PRODUCTO ── */
  .btn-nuevo-prod{width:100%;padding:11px;border-radius:var(--radius);border:2px dashed var(--border2);background:transparent;color:var(--text2);font-family:'Syne',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.2s;margin-top:8px;letter-spacing:0.3px;}
  .btn-nuevo-prod:hover{border-color:var(--accent2);color:var(--accent2);background:rgba(68,114,200,0.06);}

  /* ── TOOLTIP EN BOTONES PROVEEDOR ── */
  .prov-btn{position:relative;}
  .prov-btn[data-tooltip]:hover::after{content:attr(data-tooltip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:#0a0d14;color:#e8ecf5;border:1px solid var(--border2);border-radius:8px;padding:5px 10px;font-size:11px;white-space:nowrap;z-index:100;pointer-events:none;font-family:'Syne',sans-serif;font-weight:600;}

  /* ── DASHBOARD ADM ── */
  #dashboard-adm{display:none;}
  .dash-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;}
  .dash-title{font-size:20px;font-weight:800;color:var(--text);}
  .dash-filtros{display:flex;gap:8px;flex-wrap:wrap;}
  .dash-tab{padding:7px 16px;border-radius:20px;border:1px solid var(--border);background:var(--surface2);color:var(--text2);font-family:'Syne',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;}
  .dash-tab.active{border-color:var(--accent);color:#fff;background:rgba(68,114,200,0.2);}
  .dash-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px;}
  #dash-cat-tabs .dash-tab{padding:10px 18px;font-size:14px;font-weight:700;}
  .dash-kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;text-align:center;}
  .dash-kpi-val{font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:800;color:var(--accent2);}
  .dash-kpi-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;}
  .dash-section{margin-bottom:14px;}
  .dash-section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);margin-bottom:10px;display:flex;align-items:center;gap:6px;}
  .dash-fact-item{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .dash-fact-nro{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--accent2);min-width:70px;}
  .dash-fact-prov{font-size:12px;font-weight:700;color:var(--text);flex:1;}
  .dash-fact-meta{font-size:11px;color:var(--muted);}
  .dash-fact-items{background:rgba(68,114,200,0.12);border-radius:12px;padding:2px 8px;font-size:11px;font-weight:700;color:var(--accent2);font-family:'JetBrains Mono',monospace;}
  .dash-alza-item{background:var(--surface2);border-left:3px solid var(--red);border-radius:8px;padding:9px 12px;margin-bottom:6px;}
  .dash-baja-item{background:var(--surface2);border-left:3px solid var(--green);border-radius:8px;padding:9px 12px;margin-bottom:6px;}
  .dash-prod-nombre{font-size:13px;font-weight:700;color:var(--text);}
  .dash-prod-meta{font-size:11px;color:var(--muted);margin-top:2px;}
  .dash-delta{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:800;}
  .dash-empty{text-align:center;padding:24px;color:var(--muted);font-size:13px;}
  .dash-user-filter{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;}
  .dash-user-btn{padding:5px 14px;border-radius:20px;border:1px solid var(--border);background:var(--surface2);color:var(--text2);font-family:'Syne',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;}
  .dash-user-btn.active{border-color:var(--accent2);color:var(--accent2);background:rgba(107,159,232,0.1);}
  .btn-normalizar{padding:12px 20px;border-radius:var(--radius);border:2px solid var(--yellow);background:rgba(243,156,18,0.1);color:var(--yellow);font-family:'Syne',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:all 0.2s;width:100%;margin-top:8px;}
  .btn-normalizar:hover{background:rgba(243,156,18,0.2);}
  .btn-dashboard{padding:8px 16px;border-radius:20px;border:1px solid var(--border2);background:var(--surface2);color:var(--text2);font-family:'Syne',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.2s;display:none;}
  .btn-dashboard.visible{display:inline-flex;align-items:center;gap:6px;}
