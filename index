      <label class="form-label">Valor Factura ($) <span style="color:var(--muted);font-weight:400;text-transform:none;font-size:10px">columna Valor</span></label>
      <div class="input-money-wrap"><input type="text" id="valor-carancho" class="form-input" inputmode="numeric" autocomplete="off" placeholder="Ej: $26.310" oninput="formatMoneyInput(this);calcularCostoRealCarancho()"></div>
    </div>
    <div class="form-group">
      <label class="form-label">Cantidad</label>
      <input type="number" id="cant-carancho" class="form-input" placeholder="Ej: 3" inputmode="numeric" oninput="calcularCostoRealCarancho()">
    </div>
  </div>
  <div class="costo-real-box" id="costo-real-box-carancho" style="border-color:#fbbf24;display:none">
    <div class="label">Costo real por unidad</div>
    <div class="valor" id="costo-real-valor-carancho" style="color:#fbbf24">$0</div>
    <div class="desglose">
      <div class="desglose-row"><span>Valor factura</span><span id="car-d-valor">—</span></div>
      <div class="desglose-row"><span id="car-d-cant-label">÷ unidades</span><span id="car-d-unit">—</span></div>
      <div class="desglose-row"><span>+ IVA 19%</span><span id="car-d-iva">—</span></div>
      <div class="desglose-row total" style="color:#fbbf24"><span>Costo real/unidad</span><span id="car-d-real">—</span></div>
    </div>
  </div>
  <div id="hist-carancho"></div>
  <div id="alerta-carancho" class="alerta"></div>
  <button class="btn-nuevo-prod" onclick="nuevoProducto()" style="display:none" id="btn-nuevo-Carancho">🔄 Nuevo producto</button>
</div>

<!-- FORMULARIO CASAWER -->
<div class="card hidden" id="form-casawer">
  <div class="card-title">
    <span class="badge" style="background:rgba(6,182,212,0.2);color:#22d3ee">Casawer</span>
    &nbsp;Pisco Sour Artesanal
  </div>
  <div class="form-group">
    <label class="form-label">Producto <span style="color:var(--red);font-size:13px">*</span></label>
    <select id="sel-casawer" class="form-input" onchange="onSelCasawer();buscarHistorialCasawer()">
      <option value="">— Selecciona producto —</option>
      <option value="Pisco Sour 1.2 LT">Pisco Sour 1.2 LT</option>
      <option value="Pisco Sour 500cc">Pisco Sour 500cc</option>
      <option value="__otro__">— Otro (ingresar manualmente) —</option>
    </select>
  </div>
  <div class="form-group hidden" id="casawer-otro-wrap">
    <label class="form-label">Nombre del producto</label>
    <input type="text" id="nombre-casawer-otro" class="form-input" placeholder="Ej: Pisco Sour Maqui 750ml">
  </div>
  <div class="form-group">
    <label class="form-label">Código de Barra <span style="color:var(--muted);font-weight:400;text-transform:none;font-size:10px">se autocompleta</span></label>
    <input type="text" id="cod-casawer" class="form-input" placeholder="Selecciona un producto" inputmode="numeric">
  </div>
  <div class="row-2">
    <div class="form-group">
      <label class="form-label">Valor Factura ($) <span style="color:var(--muted);font-weight:400;text-transform:none;font-size:10px">columna Valor</span></label>
      <div class="input-money-wrap"><input type="text" id="valor-casawer" class="form-input" inputmode="numeric" autocomplete="off" placeholder="Ej: $47.500" oninput="formatMoneyInput(this);calcularCostoRealCasawer()"></div>
    </div>
    <div class="form-group">
      <label class="form-label">Cantidad</label>
      <input type="number" id="cant-casawer" class="form-input" placeholder="Ej: 5" inputmode="numeric" oninput="calcularCostoRealCasawer()">
    </div>
  </div>
  <div class="costo-real-box" id="costo-real-box-casawer" style="border-color:#22d3ee;display:none">
    <div class="label">Costo real por unidad</div>
    <div class="valor" id="costo-real-valor-casawer" style="color:#22d3ee">$0</div>
    <div class="desglose">
      <div class="desglose-row"><span>Valor factura</span><span id="cas-d-valor">—</span></div>
      <div class="desglose-row"><span id="cas-d-cant-label">÷ unidades</span><span id="cas-d-unit">—</span></div>
      <div class="desglose-row"><span>+ IVA 19%</span><span id="cas-d-iva">—</span></div>
      <div class="desglose-row total" style="color:#22d3ee"><span>Costo real/unidad</span><span id="cas-d-real">—</span></div>
    </div>
  </div>
  <div id="hist-casawer"></div>
  <div id="alerta-casawer" class="alerta"></div>
  <button class="btn-nuevo-prod" onclick="nuevoProducto()" style="display:none" id="btn-nuevo-Casawer">🔄 Nuevo producto</button>
</div>

<!-- FORMULARIO JESTER -->
<div class="card hidden" id="form-jester">
  <div class="card-title">
    <span class="badge" style="background:rgba(250,204,21,0.2);color:#facc15">Jester</span>
    &nbsp;Cerveza Artesanal (Hutchings y Ricci)
  </div>
  <div class="form-group">
    <label class="form-label">Monto Log&iacute;stica (subtotal) de la factura</label>
    <div class="input-money-wrap"><input type="text" id="logistica-jester" class="form-input" inputmode="numeric" autocomplete="off" placeholder="Ej: $20.571" oninput="formatMoneyInput(this);recalcularJester()"></div>
  </div>
  <div class="sep"></div>
  <p style="font-size:12px;color:var(--muted);margin-bottom:12px">Ingresa cada variedad de la factura.</p>
  <div id="jester-lista-productos" style="margin-bottom:10px"></div>
  <div class="row-2" style="margin-bottom:8px">
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">C&oacute;digo de barra</label>
      <input type="text" id="cod-jester-new" class="form-input" placeholder="Ej: 7891234" inputmode="numeric" style="font-size:13px">
    </div>
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">Nombre variedad</label>
      <input type="text" id="nombre-jester-new" class="form-input" placeholder="Ej: Manitoba Ale 5,2&deg;" style="font-size:13px">
    </div>
  </div>
  <div class="row-2" style="margin-bottom:8px">
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">Cantidad (unidades)</label>
      <input type="number" id="cant-jester-new" class="form-input" placeholder="Ej: 8" inputmode="numeric" style="font-size:13px">
    </div>
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">Monto Subtotal ($)</label>
      <div class="input-money-wrap"><input type="text" id="subtotal-jester-new" class="form-input" inputmode="numeric" autocomplete="off" placeholder="Ej: $11.090" oninput="formatMoneyInput(this)" style="font-size:13px"></div>
    </div>
  </div>
  <button type="button" onclick="agregarProductoJester()" style="width:100%;padding:10px;border-radius:10px;border:2px dashed #facc15;background:rgba(250,204,21,0.08);color:#facc15;font-family:Syne,sans-serif;font-size:14px;font-weight:700;cursor:pointer;margin-bottom:12px">+ Agregar variedad</button>
  <div id="jester-total-box" style="display:none;padding:12px 16px;background:rgba(250,204,21,0.08);border:1px solid #facc15;border-radius:10px;margin-bottom:12px;font-size:13px;color:#facc15;font-family:JetBrains Mono,monospace;font-weight:600"></div>
  <div id="hist-jester"></div>
  <div id="alerta-jester" class="alerta"></div>
  <button class="btn-nuevo-prod" onclick="nuevoProducto()" style="display:none" id="btn-nuevo-Jester">🔄 Nuevo producto</button>
</div>

<!-- MARGENES (compartido) -->
<div class="card hidden" id="card-margenes">
  <div class="card-title">&#x1F4B0; Precios de venta sugeridos</div>
  <div id="precio-actual-box" class="hidden" style="margin-bottom:12px"></div>
  <div id="margenes-normal">
    <div class="margenes-grid">
      <div class="margen-item" onclick="seleccionarPrecioDesdeMargen(20, this)" style="cursor:pointer" title="Fijar referencia 20%"><div class="margen-label">20%</div><div class="margen-valor" id="r20">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioDesdeMargen(25, this)" style="cursor:pointer" title="Fijar referencia 25%"><div class="margen-label">25%</div><div class="margen-valor" id="r25">&mdash;</div></div>
      <div class="margen-item highlight" onclick="seleccionarPrecioDesdeMargen(30, this)" style="cursor:pointer" title="Fijar referencia 30%"><div class="margen-label">30%</div><div class="margen-valor" id="r30">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioDesdeMargen(35, this)" style="cursor:pointer" title="Fijar referencia 35%"><div class="margen-label">35%</div><div class="margen-valor" id="r35">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioDesdeMargen(40, this)" style="cursor:pointer" title="Fijar referencia 40%"><div class="margen-label">40%</div><div class="margen-valor" id="r40">&mdash;</div></div>
      <div class="margen-item pedidosya">
        <div>
          <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d9/PedidosYa_logo.svg/320px-PedidosYa_logo.svg.png" style="height:22px;object-fit:contain;vertical-align:middle;margin-bottom:2px" alt="PedidosYa">
          <div style="font-size:10px;color:var(--muted);margin-top:2px;letter-spacing:0.5px">precio sugerido</div>
        </div>
        <div class="margen-valor" id="rpy">&mdash;</div>
      </div>
    </div>
  </div>
  <div id="margenes-pack" class="hidden">
    <div class="margenes-grid-pack">
      <div class="pack-header">Margen</div>
      <div class="pack-header">Unitario</div>
      <div class="pack-header" id="pack-header-label">Pack x6</div>
      <div class="margen-item"><div class="margen-label">20%</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(20,'u',this)" style="cursor:pointer" title="Seleccionar precio unitario 20%"><div class="margen-valor" id="r20u">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(20,'p',this)" style="cursor:pointer" title="Seleccionar precio pack 20%"><div class="margen-valor" id="r20p">&mdash;</div></div>
      <div class="margen-item"><div class="margen-label">25%</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(25,'u',this)" style="cursor:pointer" title="Seleccionar precio unitario 25%"><div class="margen-valor" id="r25u">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(25,'p',this)" style="cursor:pointer" title="Seleccionar precio pack 25%"><div class="margen-valor" id="r25p">&mdash;</div></div>
      <div class="margen-item highlight"><div class="margen-label">30%</div></div>
      <div class="margen-item highlight" onclick="seleccionarPrecioPackDesde(30,'u',this)" style="cursor:pointer" title="Seleccionar precio unitario 30%"><div class="margen-valor" id="r30u">&mdash;</div></div>
      <div class="margen-item highlight" onclick="seleccionarPrecioPackDesde(30,'p',this)" style="cursor:pointer" title="Seleccionar precio pack 30%"><div class="margen-valor" id="r30p">&mdash;</div></div>
      <div class="margen-item"><div class="margen-label">35%</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(35,'u',this)" style="cursor:pointer" title="Seleccionar precio unitario 35%"><div class="margen-valor" id="r35u">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(35,'p',this)" style="cursor:pointer" title="Seleccionar precio pack 35%"><div class="margen-valor" id="r35p">&mdash;</div></div>
      <div class="margen-item"><div class="margen-label">40%</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(40,'u',this)" style="cursor:pointer" title="Seleccionar precio unitario 40%"><div class="margen-valor" id="r40u">&mdash;</div></div>
      <div class="margen-item" onclick="seleccionarPrecioPackDesde(40,'p',this)" style="cursor:pointer" title="Seleccionar precio pack 40%"><div class="margen-valor" id="r40p">&mdash;</div></div>
      <div class="margen-item pedidosya" style="grid-column:span 1">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d9/PedidosYa_logo.svg/320px-PedidosYa_logo.svg.png" style="height:18px;object-fit:contain" alt="PedidosYa">
      </div>
      <div class="margen-item pedidosya" style="grid-column:span 1"><div class="margen-valor" id="rpyu">&mdash;</div></div>
      <div class="margen-item pedidosya" style="grid-column:span 1"><div class="margen-valor" id="rpyp">&mdash;</div></div>
    </div>
  </div>
  <button class="btn-save" id="btn-save" onclick="guardar()" disabled style="opacity:0.5">&#x1F446; Selecciona un precio de venta primero</button>

  <!-- Campo precio elegido editable -->
  <div id="precio-elegido-wrap" style="display:none;margin-bottom:12px;padding:12px 14px;background:var(--surface2);border:1px solid var(--green);border-radius:var(--radius)">
    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--green);margin-bottom:8px">💰 Precio elegido — editable</div>
    <div style="display:flex;align-items:center;gap:10px">
      <div style="position:relative;flex:1">
        <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--accent2);font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;pointer-events:none">$</span>
        <input type="text" id="precio-elegido-input" inputmode="numeric" autocomplete="off" placeholder="0"
          style="width:100%;padding:10px 12px 10px 26px;background:var(--surface);border:2px solid var(--accent);border-radius:10px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:16px;font-weight:700;outline:none"
          onfocus="this.value=this.dataset.raw||''; this.select();"
          onblur="formatPrecioElegido(this)"
          oninput="formatPrecioElegidoLive(this)">
      </div>
      <div id="precio-elegido-pct" style="font-size:12px;color:var(--muted);white-space:nowrap;min-width:60px;font-weight:700"></div>
    </div>
    <div id="precio-elegido-error" style="display:none;margin-top:6px;font-size:12px;color:var(--red);font-weight:700"></div>
  </div>
</div>

</div>

<!-- TOAST OK -->
<div class="toast" id="toast">&#x2705; Guardado correctamente</div>
<!-- TOAST ERROR -->
<div class="toast-error" id="toast-error">&#x26A0;&#xFE0F; Error</div>

</body>
</html>
